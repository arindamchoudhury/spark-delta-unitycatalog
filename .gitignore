.claude
spark/tar/*
spark/jar/*
metadata/ivy/**
metadata/uc/**
metadata/uc-db/**
metadata/spark-events/**
workspace/data/**
!workspace/data/gutenberg_books/
!workspace/data/gutenberg_books/**

# Postgres
metadata/postgres/**

# MinIO / S3
metadata/minio/**

# Additional Untracked Files
__pycache__/
workspace/dagster/.nux/
workspace/dagster/.telemetry/
workspace/dagster/history/
workspace/dagster/storage/
bundle-*.jar

# Unity Catalog config directory (contains rotated credentials)
uc-conf/*
!uc-conf/server.properties.orig
# Mounting uc-conf over the image's etc/conf hides the files UC ships there.
# These three carry no credentials and must be present or UC silently falls
# back to an in-memory H2 database (see HibernateConfigurator).
!uc-conf/hibernate.properties
!uc-conf/cli.log4j2.properties
!uc-conf/server.log4j2.properties

# Ignore notebooks except intro.ipynb
workspace/notebooks/*.ipynb
!workspace/notebooks/intro.ipynb
