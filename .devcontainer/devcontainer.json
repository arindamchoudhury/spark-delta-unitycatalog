{
  "name": "spark-delta-unitycatalog",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "spark",
  "runServices": [
    "minio",
    "postgres",
    "unitycatalog",
    "ui",
    "spark",
    "spark-history",
    "dagster-user-code",
    "dagster-webserver",
    "dagster-daemon"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/envs/spark/bin/python3"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "humao.rest-client",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}